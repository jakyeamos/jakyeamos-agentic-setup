{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.project-compass/quiz.schema.json",
  "title": "Project Compass Quiz Sessions",
  "type": "object",
  "required": ["schema_version", "sessions", "updated_at"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "sessions": {
      "type": "array",
      "items": { "$ref": "#/$defs/session" }
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "source": {
      "type": "object",
      "required": ["ref", "observed_at"],
      "additionalProperties": false,
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "note": { "type": "string" },
        "observed_at": { "type": "string", "format": "date-time" }
      }
    },
    "question": {
      "type": "object",
      "required": ["id", "category", "prompt"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "category": { "type": "string", "minLength": 1 },
        "prompt": { "type": "string", "minLength": 1 }
      }
    },
    "answer": {
      "type": "object",
      "required": [
        "question_id",
        "value",
        "status",
        "source",
        "answered_at"
      ],
      "additionalProperties": false,
      "properties": {
        "question_id": { "$ref": "#/$defs/id" },
        "value": { "type": "string", "minLength": 1 },
        "status": {
          "enum": ["explicit", "tentative", "unknown", "skipped"]
        },
        "source": { "$ref": "#/$defs/source" },
        "answered_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "session": {
      "type": "object",
      "required": [
        "id",
        "mode",
        "compass_id",
        "scope_kind",
        "status",
        "questions",
        "answers",
        "started_at",
        "updated_at"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "mode": {
          "enum": ["greenfield", "brownfield", "realignment"]
        },
        "compass_id": { "$ref": "#/$defs/id" },
        "scope_kind": { "enum": ["root", "subsystem"] },
        "status": { "enum": ["active", "complete", "abandoned"] },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/question" }
        },
        "answers": {
          "type": "array",
          "items": { "$ref": "#/$defs/answer" }
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
