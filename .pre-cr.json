{
  "version": 1,
  "testCommand": "python3 scripts/pre_cr_coverage.py",
  "coveragePaths": [
    ".pre-cr/coverage.lcov"
  ],
  "coverageFormat": "lcov",
  "threshold": 0,
  "surfaces": {
    "covered": [
      "scripts/validate_skills.py",
