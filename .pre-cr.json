{
  "version": 1,
  "testCommand": "python3 scripts/pre_cr_coverage.py",
  "coveragePaths": [
    ".pre-cr/coverage.lcov"
  ],
  "coverageFormat": "lcov",
  "threshold": 0,
  "qualityAdapters": [
    {
      "name": "anti-slop",
      "command": "anti-slop gate --files {changedFiles} --mode block --format pre-cr",
      "required": true
    },
    {
      "name": "prevention-pack",
      "command": "python3 scripts/validate_prevention_pack.py --json",
      "required": true
    }
  ],
  "surfaces": {
    "covered": [
      "scripts/validate_skills.py",
      "scripts/catalog_validation.py",
      "scripts/public_safety_check.py",
      "scripts/validate_catalog.py",
      "scripts/workbench.py",
      ".tracker/**"
    ],
    "ignored": [
      ".gitignore",
      ".pre-cr.json",
      "ATTRIBUTION.md",
      "LICENSE",
      "README.md",
      "SECURITY.md",
      "scripts/pre_cr_coverage.py",
      "skills/**",
      "tests/**",
      "docs/**",
      "workflows/**",
      "adapters/**",
      "fixtures/**",
      "catalog/**",
      ".planning/**"
    ],
    "unsupported": []
  },
  "checks": {
    "coverage": false,
    "security": true,
    "checklist": true
  }
}
